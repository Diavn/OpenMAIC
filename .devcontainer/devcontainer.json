{
  "name": "OpenMAIC - Codespaces (safe startup)",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu",
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {}
  },
  "forwardPorts": [
    3000
  ],
  "portsAttributes": {
    "3000": {
      "label": "OpenMAIC web app (private)",
      "onAutoForward": "notify",
      "visibility": "private"
    }
  },
  "postCreateCommand": "test -f .env.local || cp .env.example .env.local"
}
